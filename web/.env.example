# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# Public origin used for cookie domain, CSRF, and reverse-proxy detection.
PUBLIC_ORIGIN=https://registry.example.com
# Comma-separated trusted reverse-proxy IPs (so X-Forwarded-* is honored).
TRUST_PROXY=127.0.0.1,::1

# ─── Cookies / sessions ──────────────────────────────────────────────────────
# Long random string (>=32 bytes). Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-32-byte-hex-string
COOKIE_SECURE=true

# ─── Database ────────────────────────────────────────────────────────────────
# Inside the container. Bind-mount /data on the host.
DATABASE_PATH=/data/registry-web.db

# ─── GitHub App ──────────────────────────────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
# Required permissions: contents=write, pull_requests=write, metadata=read
# Install it ONLY on your registry repository.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/app.pem
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=BeamNG-Mod-Registry
GITHUB_DEFAULT_BRANCH=main
# Set to true to enable auto-merge on bot-opened PRs (requires repo to allow it).
GITHUB_AUTO_MERGE=true

# ─── Working copy ────────────────────────────────────────────────────────────
# Local clone of the registry. Container will clone here on boot if missing.
REPO_WORKDIR=/data/repo

# ─── Registry browser source ─────────────────────────────────────────────────
# Where the public mod browser pulls metadata from.
#   auto   — try the published GitHub Releases index first, fall back to local
#   remote — only use the published index (recommended for hosted deployments)
#   local  — only use the local mods/ directory under REPO_WORKDIR
REGISTRY_SOURCE=auto
# Override the index URL if you fork the registry or self-host a mirror.
# Default: https://github.com/${GITHUB_REPO_OWNER}/${GITHUB_REPO_NAME}/releases/latest/download/registry-index.json
REGISTRY_INDEX_URL=
# How often (ms) to re-fetch the remote index. Default 5 minutes.
REGISTRY_REFRESH_MS=300000

# ─── Email (optional, v1 may skip verification) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=registry@example.com
EMAIL_VERIFICATION_REQUIRED=false

# ─── Captcha (optional, recommended for public deployments) ─────────────────
# Cloudflare Turnstile — free at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Public abuse hardening ──────────────────────────────────────────────────
# Max bytes accepted by /submissions/inspect-upload. 500 MiB default.
SUBMIT_MAX_UPLOAD_BYTES=524288000

# ─── Bootstrap admin (optional) ──────────────────────────────────────────────
# If set, the first signup matching this email is auto-promoted to admin.
BOOTSTRAP_ADMIN_EMAIL=
